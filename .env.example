# ─────────────────────────────────────────────────────────────────────────────
# Backend (FastAPI) — set these in the Railway service, NOT committed.
# ─────────────────────────────────────────────────────────────────────────────

# AI (chart math needs NO key; readings, chat, palmistry, vastu do)
GEMINI_API_KEY=                       # required for all AI features
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash   # used if the primary model is overloaded (503)

# CORS — comma-separated origins allowed to call the API directly from a browser.
# MUST be the deployed frontend origin(s) in production; NEVER "*".
CORS_ORIGINS=http://localhost:3000

# Supabase (server-side writer of premium state; RLS-bypassing — keep secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # service_role key — server-side ONLY, never ship to the browser
SUPABASE_JWT_SECRET=                  # only if REQUIRE_API_AUTH=true (HS256 JWT verification)

# Server-side API auth for the paid endpoints (chat, weekly jyothishyam).
# Leave false until the frontend is sending the Supabase token AND you have
# verified login works; then set true to enforce entitlement server-side.
REQUIRE_API_AUTH=false

# Payments — DORMANT until set. Stripe = cards/international, Razorpay = India/UPI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                # from the Stripe webhook endpoint (whsec_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — set in Vercel. See frontend/.env.example for the rest.
# ─────────────────────────────────────────────────────────────────────────────
JYOTISH_API_URL=http://localhost:8000   # the Railway API URL in production
